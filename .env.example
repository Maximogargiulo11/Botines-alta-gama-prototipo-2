# === OBLIGATORIAS ===
DATABASE_URL=postgresql://user:password@host:5432/database
ADMIN_USERNAME=admin
# Generá el hash con: node scripts/hash-password.js tuPassword
# El sistema acepta tanto la contraseña plana como el hash bcrypt
ADMIN_PASSWORD=$2b$12$hash-generado-con-el-script
JWT_SECRET=un-string-aleatorio-largo-y-secreto-minimo-32-caracteres

# === OPCIONALES ===
PORT=3001
# URL del frontend en Vercel (para CORS en producción)
FRONTEND_URL=https://tu-app.vercel.app
NODE_ENV=production
